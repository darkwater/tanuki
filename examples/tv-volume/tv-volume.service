[Unit]
Description=TV volume bridge for Tanuki

[Service]
# Replace the executable path and TV UDN from --discover.
# Discovery and callback selection run on each startup; no TV IP is stored.
ExecStart=%h/github/darkwater/tanuki/target/release/tanuki-tv-volume --device uuid:YOUR-TV-ID
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
