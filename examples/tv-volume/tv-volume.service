[Unit]
Description=TV volume bridge for Tanuki

[Service]
# Replace these paths/addresses. The description path is a placeholder.
ExecStart=%h/github/darkwater/tanuki/target/release/tanuki-tv-volume http://192.168.1.50:9197/description.xml http://192.168.1.20:9198/notify 0.0.0.0:9198 ws://127.0.0.1:5167/v1/ws
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
